# Release-age gate (supply-chain protection): `npm install` and `npm update`
# resolve only versions published at least 5 days ago, so a malicious release
# is usually caught and unpublished before it can reach package-lock.json.
# Needs npm 11.10 or newer (the devcontainer's Node 24 ships npm 11.19); older
# npm ignores the key. CI runs `npm ci`, which installs the reviewed lock file
# exactly and resolves nothing, so the gate acts where the lock file changes.
min-release-age=5
