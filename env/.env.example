# Application URLs (the public practice site; copy this file to env/.env.dev and run)
APP_URL=https://practicesoftwaretesting.com
API_URL=https://api.practicesoftwaretesting.com

# Test user: NOT needed. The setup-api project registers a private run user
# (or reuses the one saved in .auth/app/runUser.json) and sets APP_EMAIL and
# APP_PASSWORD for every test at runtime. Fill these in only to explore the
# site by hand with a personal account; the tests ignore them.
APP_EMAIL=
APP_PASSWORD=

# Additional service URLs
UTILITY_URL=https://your-utility-service.com

